# Copy this file to .env and replace deployment-specific values.
# Docker Compose loads .env automatically; .env is ignored by Git.

# Required: names of the existing Docker networks.
LIBRECHAT_NETWORK=librechat_default
CADDY_NETWORK=caddy

# Required for generating downloadable links; replace with the public HTTPS origin.
ARTIFACT_PUBLIC_BASE_URL=https://downloads.example.com

# Native DocuSeal MCP origin and server-side Bearer credential. The endpoint is derived as /mcp.
ARTIFACT_PORT=8001
DOCUSEAL_URL=https://signature.bullprog.com
DOCUSEAL_MCP_BEARER_TOKEN=

# Artifact lifecycle and storage limits.
ARTIFACT_RETENTION_SECONDS=86400
MAX_ARTIFACT_BYTES=268435456
MAX_ARTIFACT_FILES=100

# Rendering limits. Keep concurrency at 1.
MAX_CONCURRENT_RENDERS=1
MAX_INPUT_BYTES=2097152
MAX_OUTPUT_BYTES=20971520
MAX_PAGES=100
MAX_IMAGE_BYTES=2097152
MAX_IMAGE_PIXELS=20000000
WORKER_TIMEOUT_SECONDS=60
